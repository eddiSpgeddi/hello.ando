---
// Shared page shell: icons, fonts, tokens, ui styles, and the theme script
// that has to run before first paint.
import "design-system";
import "ui/styles.css";

interface Props {
  title?: string;
}

const { title = "hello.ando" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500&family=Fira+Code:wght@500&display=swap"
    />
    <title>{title}</title>
    <script is:inline>
      // Apply a saved theme before first paint. Kept in sync with src/scripts/theme-toggle.ts.
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
      // Splash only on the first page load of a visit. Same try/catch reason as above.
      // TODO: revisit this once the splash is a proper component, so it can be toggled on/off in the UI. Also have this wait for the page to load (vs a set timeout)
      try {
        // if (sessionStorage.getItem("splash")) document.documentElement.dataset.splash = "seen";
        // else sessionStorage.setItem("splash", "seen");
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      // registers <ui-lockup>
      import "ui";
    </script>
  </body>
</html>
